<odoo>
    <data noupdate="1">
        <record id="purchase_request_department_rule" model="ir.rule">
            <field name="name">Solicitudes de Compra: Ver solo mi departamento</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="domain_force">
                ['|',
                 ('requester_id', '=', user.id),
                 ('department_id', '=', user.employee_id.department_id.id)
                ]
            </field>
            <field name="groups" eval="[(4, ref('custom_purchase_request.group_purchase_request_user'))]"/>
            </record>

        <record id="purchase_request_manager_all_records_rule" model="ir.rule">
            <field name="name">Solicitudes de Compra: Administrador puede ver todo</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="domain_force">[(1, '=', 1)]</field> <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
            </record>
    </data>
</odoo>
