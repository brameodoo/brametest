<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Regla para que los usuarios normales vean solo las solicitudes de su departamento -->
        <record id="purchase_request_department_user_rule" model="ir.rule">
            <field name="name">Solicitudes de Compra: Visibilidad por Departamento</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">
                ['|', ('department_id', '=', False), ('department_id', 'in', user.employee_ids.department_id.ids)]
            </field>
        </record>

        <!-- Regla para que los Gerentes de Compra vean todas las solicitudes -->
        <!-- Esta regla debe tener una prioridad más alta si es necesario, pero los grupos suelen resolver esto. -->
        <record id="purchase_request_purchase_manager_rule" model="ir.rule">
            <field name="name">Solicitudes de Compra: Visibilidad Total para Gerente de Compra</field>
            <field name="model_id" ref="model_purchase_request"/>
            <field name="groups" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>