<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_request_form_view" model="ir.ui.view">
            <field name="name">purchase.request.form</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <form string="Solicitud de Compra">
                    <header>
                        <button name="action_submit_for_approval" string="Enviar para Aprobación" type="object"
                                class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_approve" string="Aprobar" type="object"
                                class="oe_highlight" groups="purchase.group_purchase_manager"
                                invisible="state != 'to_approve'"/>
                        <button name="action_set_to_done" string="Marcar como Realizada" type="object"
                                class="oe_highlight" groups="purchase.group_purchase_manager"
                                invisible="state != 'approved'"/>
                        
                        <button name="action_generate_purchase_order" string="Generar Orden de Compra" type="object" 
                                class="oe_highlight" groups="purchase.group_purchase_manager"
                                invisible="1"/> 

                        <button name="action_cancel" string="Cancelar" type="object" 
                                confirm="¿Estás seguro de que quieres cancelar esta solicitud?"
                                invisible="state in ('cancel', 'done')"/>
                        <button name="action_reset_to_draft" string="Restablecer a Borrador" type="object" 
                                groups="purchase.group_purchase_manager"
                                invisible="state != 'cancel'"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,done"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="requester_id" readonly="1"/>
                                <field name="department_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="request_date"/>
                                <field name="purchase_order_id" invisible="purchase_order_id == False"/>
                                <field name="project_id"/>
                                <field name="vendor_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Líneas de Solicitud">
                                <field name="line_ids">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="uom_id"/>
                                        <field name="price_unit" widget="monetary" options="{'currency_field': 'currency_id'}"/> 
                                        <field name="taxes_id" widget="many2many_tags" options="{'no_create': True}"/> 
                                        <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/> 
                                        <field name="note"/>
                                        <field name="currency_id" invisible="1"/> 
                                        <field name="price_total" invisible="1"/> 
                                        <field name="request_id" invisible="1"/>
                                    </tree>
                                </field>
                                <group class="oe_subtotal_footer oe_right" colspan="2" name="amount_total_group">
                                    <field name="amount_untaxed" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount_tax" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="amount_total" class="oe_amount_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                                <div class="clearfix"/>
                            </page>
                            <page string="Información de Aprobación" invisible="state == 'draft'">
                                <group>
                                    <field name="approver_id"/>
                                    <field name="approval_date"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="purchase_request_tree_view" model="ir.ui.view">
            <field name="name">purchase.request.tree</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <tree string="Solicitudes de Compra">
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="department_id"/>
                    <field name="request_date"/>
                    <field name="state" widget="badge" decoration-warning="state == 'to_approve'" decoration-info="state == 'draft'" decoration-success="state == 'approved'" decoration-muted="state == 'done'" decoration-danger="state == 'cancel'"/>
                    <field name="amount_untaxed" sum="Total sin Impuestos" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_total" sum="Total con Impuestos" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="currency_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="purchase_request_search_view" model="ir.ui.view">
            <field name="name">purchase.request.search</field>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <search string="Buscar Solicitud de Compra">
                    <field name="name"/>
                    <field name="requester_id"/>
                    <field name="department_id"/>
                    <field name="state"/>
                    <filter name="my_requests" string="Mis Solicitudes" domain="[('requester_id', '=', uid)]"/>
                    <group expand="0" string="Agrupar por">
                        <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
                        <filter name="group_by_requester" string="Solicitante" context="{'group_by': 'requester_id'}"/>
                        <filter name="group_by_department" string="Departamento" context="{'group_by': 'department_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
